+  s3_sched_stale = s3_sched("s3_sched_stale", list(B = 8:14), s3_stale(2, "freeze"))))
+s3_hist_strategy <- function(ctx, params) {
+  m <- ledgr::ledgr_history_matrix(ctx, bar = "close", lookback = 3L)
+  info <- ledgr::ledgr_history_info(m)
+  f <- ledgr::ledgr_history_frame(ctx, bar = "close", lookback = 2L)
+  t <- ctx$hold()
+  s <- sum(m, na.rm = TRUE) + nrow(f) + length(info)
+  t[ctx$universe[[1L]]] <- if (floor(s) %% 2 == 1) 10 else 0
+  t
+}
+s3_hist <- function(name, drop, valuation = NULL) function() {
