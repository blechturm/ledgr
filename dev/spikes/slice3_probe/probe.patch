+s3_param_strategy <- function(ctx, params) {
+  targets <- ctx$hold()
+  if (substr(ctx$ts_utc, 1L, 10L) == "2020-01-02") targets[c("A", "B")] <- params$q
+  targets
+}
+loop_slice2 <- c(loop_slice2, list(
+  s3_risk_mark_stop = s3_case("s3_risk_mark_stop", list(C = 4:12), s3_plan(list(2L, c(A = 10)), list(10L, c(C = 5))),
+    s3_stale(2, "freeze")),
+  s3_stale_reduction = s3_case("s3_stale_reduction", list(B = 7:8), s3_plan(list(2L, c(A = 10, B = 20)), list(8L, c(B = 200))),
+    s3_stale(3, "freeze"), risk = ledgr::ledgr_risk_max_weight(0.3)),
+  s3_freeze_exit = s3_case("s3_freeze_exit", list(B = 8:14), s3_plan(list(2L, c(A = 10, B = 10))), s3_stale(2, "freeze")),
+  s3_sweep = function() {
+    db <- s3_snapshot("s3_sweep", s3_closes(list(B = 8:14)))
+    snapshot <- ledgr::ledgr_snapshot_open(db, "s3_sweep", verify = TRUE)
+    on.exit(ledgr::ledgr_snapshot_close(snapshot))
+    exp <- ledgr::ledgr_experiment(snapshot, s3_param_strategy, opening = ledgr::ledgr_opening(cash = 1e4),
+      cost_model = ledgr::ledgr_cost_zero(), valuation_policy = s3_stale(2, "freeze"))
+    grid <- ledgr::ledgr_grid_named(a = list(strategy = list(q = 10)), b = list(strategy = list(q = 20)))
+    set.seed(8L)
+    obs <- a0_observe_memory(ledgr::ledgr_sweep(exp, grid, seed = 17L, retain = a0_retain()))
+    list(sweep = c(a0_sweep_tables(obs$value), a0_memory_tables(obs$observed, obs$value)))
+  }))
+s3_buy_ab <- function(ctx, params) { t <- ctx$hold(); t[c("A", "B")] <- 10; t }
+s3_sched <- function(name, drop, valuation = NULL) function() {
+  db <- s3_snapshot(name, s3_closes(drop))
+  exp <- function(snapshot) ledgr::ledgr_experiment(snapshot, s3_buy_ab, opening = ledgr::ledgr_opening(cash = 1e4),
+    cost_model = ledgr::ledgr_cost_zero(), schedule = ledgr::ledgr_schedule_week_start(), valuation_policy = valuation)
+  collect(db, name, paste0("s3-", name), exp, seed = 11L)
