+# slice-5 probe: after the pin starts its workers, each worker loads the lean
+# core from the same pinned library and installs the lean loop with the
+# harness hooks; every fold a worker runs appends one line to
+# Sys.getenv("LEAN_PROBE_WORKER_LOG"): pid, lean folds so far, refused,
+# backstop, store accesses, sink calls while pulses ran.
+lean_pin_worker_setup <- get("ledgr_parallel_worker_setup", envir = asNamespace("ledgr"))
+lean_worker_setup <- function(workers = 1L, preflight, worker_packages = NULL, backend = "mirai",
+                              backend_available = NULL, dry_run = TRUE) {
+  cat("SETUP", Sys.getpid(), "workers", workers, "dry_run", dry_run, "\n",
+      file = Sys.getenv("LEAN_PROBE_WORKER_LOG"), append = TRUE)
+  plan <- lean_pin_worker_setup(workers = workers, preflight = preflight, worker_packages = worker_packages,
+                                backend = backend, backend_available = backend_available, dry_run = dry_run)
+  if (!isTRUE(dry_run) && ledgr_parallel_workers_normalize(workers) > 1L) {
+    expr <- substitute(tryCatch({
+      cat("WORKER", Sys.getpid(), "ledgr from", getNamespaceInfo("ledgr", "path"), "\n", file = LOG, append = TRUE)
+      source(LOAD_R)
+      .lean <- lean_core_load(LIB, debug = DEBUG)
+      .lean$lean_loop_install(hooks = TRUE)
+      local({
+        ns <- asNamespace("ledgr")
+        env <- .lean
+        inner <- get("ledgr_fold_envelope", envir = ns)
+        log <- LOG
+        wrapped <- function(...) {
+          on.exit(cat(Sys.getpid(), env$lean_entry$lean_folds,
+                      paste(env$lean_entry$refused, collapse = ";"),
+                      paste(env$lean_entry$backstop, collapse = ";"),
+                      length(env$lean_entry$store_access), length(env$lean_entry$sink_calls),
+                      "\n", file = log, append = TRUE))
+          inner(...)
+        }
+        unlockBinding("ledgr_fold_envelope", ns)
+        assign("ledgr_fold_envelope", wrapped, envir = ns)
+        lockBinding("ledgr_fold_envelope", ns)
+      })
+      cat("WORKER", Sys.getpid(), "lean installed\n", file = LOG, append = TRUE)
+    }, error = function(e) cat("WORKER", Sys.getpid(), "ERROR", conditionMessage(e), "\n", file = LOG, append = TRUE)),
+    list(LOAD_R = file.path(.lean_home, "load.R"), LIB = .lean_lib, DEBUG = .lean_debug,
+            LOG = Sys.getenv("LEAN_PROBE_WORKER_LOG")))
+    ledgr_parallel_mirai_everywhere_expr(expr, workers = ledgr_parallel_workers_normalize(workers))
+  }
+  plan
+}
