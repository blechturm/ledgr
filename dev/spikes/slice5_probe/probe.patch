--- /dev/null
+++ b/dev/lean_core/parity/loop_workloads_slice5.R
@@ -0,0 +1,45 @@
+# slice-5 probe: workloads for the slice-5 features with no workload of their
+# own. Sourced by loop_parity.R after loop_workloads_slice4.R (whose s4_
+# helpers it uses).
+#
+# Restart (a ledgr_run() of an existing nonterminal run_id): the first
+# attempt fails in the strategy at day 5, after fills on days 2 and 4; the
+# second attempt, under the same run_id, replaces it and completes. The
+# failure is switched by an option, not a captured variable (preflight
+# refuses captured state); the pulse dates are literals in the body.
+
+s5_restart_strategy <- function() {
+  f <- function(ctx, params) NULL
+  body(f) <- substitute({
+    target <- ctx$hold()
+    if (isTRUE(getOption("ledgr.s5_probe_fail")) && identical(ctx$ts_utc, D5)) stop("s5 probe failure")
+    if (identical(ctx$ts_utc, D2)) target[["A"]] <- 5
+    if (identical(ctx$ts_utc, D4)) target[["B"]] <- 2
+    if (identical(ctx$ts_utc, D7)) {
+      target[["A"]] <- 1
+      target[["C"]] <- 4
+    }
+    target
+  }, list(D2 = s4_iso(2L), D4 = s4_iso(4L), D5 = s4_iso(5L), D7 = s4_iso(7L)))
+  environment(f) <- ns
+  f
+}
+
+s5_restart <- function(name, positions = NULL, cost_basis = NULL) function() {
+  db <- s4_snapshot(name, s4_closes(), NULL)
+  snapshot <- ledgr::ledgr_snapshot_open(db, name, verify = TRUE)
+  on.exit(ledgr::ledgr_snapshot_close(snapshot))
+  exp <- s4_exp(s5_restart_strategy(), positions = positions, cost_basis = cost_basis)(snapshot)
+  run_id <- paste0("s5-", name)
+  old <- options(ledgr.s5_probe_fail = TRUE)
+  on.exit(options(old), add = TRUE)
+  first <- collect_open(snapshot, db, run_id, exp, seed = 21L)
+  options(ledgr.s5_probe_fail = FALSE)
+  second <- collect_open(snapshot, db, run_id, exp, seed = 21L)
+  list(attempt1 = first$run, run = second$run)
+}
+
+loop_slice5 <- list(
+  s5_restart_plain = s5_restart("s5_restart_plain"),
+  s5_restart_opening = s5_restart("s5_restart_opening", positions = c(A = 3, B = 1), cost_basis = c(A = 30, B = 44))
+)
