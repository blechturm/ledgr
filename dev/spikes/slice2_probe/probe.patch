+# --- slice-2 probe workloads (probe worktree only, not committed) -----------
+p2_crossover <- function(name, n_inst, n_days, cost, risk) function() {
+  db <- build(name, function(db) ledgr::ledgr_snapshot_from_df(r_floor_fixture(n_inst, n_days)$bars, db_path = db,
+                                                              snapshot_id = name, price_basis = "split_adjusted"))
+  exp <- function(snapshot) {
+    strategy <- r_floor_transition
+    environment(strategy) <- ns
+    ledgr::ledgr_experiment(snapshot, strategy,
+      features = ledgr::ledgr_feature_map(
+        fast = ledgr::ledgr_ind_ttr("SMA", input = "close", id = "fast", n = 5L),
+        slow = ledgr::ledgr_ind_ttr("SMA", input = "close", id = "slow", n = 10L)),
+      opening = ledgr::ledgr_opening(cash = 1e7), cost_model = cost,
+      risk_chain = risk, asset_state = list(above = FALSE, usable = FALSE))
+  }
+  collect(db, name, paste0("p2-", name), exp, seed = 20260530L)
+}
+p2_schedule <- function(name, plan, cost, risk, cash = 5000) function() {
+  db <- lw_snapshot(name, lw_bars(c(A = 30, B = 45, C = 12), 20L, drift = 0.05))
+  exp <- function(snapshot) ledgr::ledgr_experiment(snapshot, lw_schedule_strategy(plan),
+    opening = ledgr::ledgr_opening(cash = cash), cost_model = cost, risk_chain = risk)
+  collect(db, name, paste0("p2-", name), exp, seed = 11L)
+}
+p2_sizing_strategy <- function(verb) {
+  s <- function(ctx, params) {
+    day <- as.integer(substr(ctx$ts_utc, 9L, 10L))
+    if (day %% 3L == 0L) {
+      if (VERB == "rebalance") ledgr::ledgr_target_rebalance(ctx, weights = c(A = 0.3, B = 0.3, C = 0.2), invest_fraction = 0.9)
+      else if (day %% 2L == 0L) ledgr::ledgr_target_adjust(ctx, exit = c(A = TRUE, B = FALSE, C = FALSE))
+      else ledgr::ledgr_target_adjust(ctx, add_value = c(B = 300, C = 150))
+    } else ctx$hold()
+  }
+  body(s) <- do.call(substitute, list(body(s), list(VERB = verb)))
+  environment(s) <- ns
+  s
+}
+p2_sizing <- function(name, verb, cost = ledgr::ledgr_cost_zero(), risk = ledgr::ledgr_risk_none()) function() {
+  db <- lw_snapshot(name, lw_bars(c(A = 30, B = 45, C = 12), 30L, drift = 0.05))
+  exp <- function(snapshot) ledgr::ledgr_experiment(snapshot, p2_sizing_strategy(verb),
+    opening = ledgr::ledgr_opening(cash = 5000), cost_model = cost, risk_chain = risk)
+  collect(db, name, paste0("p2-", name), exp, seed = 11L)
+}
+p2_days <- lw_days(20L)
+p2_short_plan <- stats::setNames(list(c(A = 3, B = -2), c(B = 4, C = -5), c(A = 0, C = 6), c(A = -1, B = 0)),
+                                 p2_days[c(2L, 5L, 9L, 13L)])
+p2_chain <- ledgr::ledgr_cost_chain(ledgr::ledgr_cost_spread_bps(10), ledgr::ledgr_cost_fixed_fee(1),
+                                    ledgr::ledgr_cost_notional_bps_fee(5))
+loop_constructed <- c(loop_constructed, list(
+  p2_cost_fixed = p2_crossover("p2_cost_fixed", 10L, 300L, ledgr::ledgr_cost_fixed_fee(1), ledgr::ledgr_risk_none()),
+  p2_cost_notional = p2_crossover("p2_cost_notional", 10L, 300L, ledgr::ledgr_cost_notional_bps_fee(5), ledgr::ledgr_risk_none()),
+  p2_cost_spread = p2_crossover("p2_cost_spread", 10L, 300L, ledgr::ledgr_cost_spread_bps(10), ledgr::ledgr_risk_none()),
+  p2_cost_chain = p2_crossover("p2_cost_chain", 10L, 300L, p2_chain, ledgr::ledgr_risk_none()),
+  p2_risk_max_weight = p2_crossover("p2_risk_max_weight", 10L, 300L, ledgr::ledgr_cost_zero(), ledgr::ledgr_risk_max_weight(0.05)),
+  p2_risk_long_only = p2_schedule("p2_risk_long_only", p2_short_plan, ledgr::ledgr_cost_zero(), ledgr::ledgr_risk_long_only()),
+  p2_risk_chain = p2_schedule("p2_risk_chain", p2_short_plan, ledgr::ledgr_cost_fixed_fee(0.5),
+    ledgr::ledgr_risk_chain(ledgr::ledgr_risk_long_only(), ledgr::ledgr_risk_max_weight(0.3))),
+  p2_sizing_rebalance = p2_sizing("p2_sizing_rebalance", "rebalance"),
+  p2_sizing_adjust = p2_sizing("p2_sizing_adjust", "adjust"),
+  p2_combo = p2_sizing("p2_combo", "rebalance", p2_chain, ledgr::ledgr_risk_max_weight(0.25))
+))
+loop_constructed <- c(loop_constructed, list(
+  p2_risk_bind = p2_crossover("p2_risk_bind", 10L, 300L, ledgr::ledgr_cost_zero(), ledgr::ledgr_risk_max_weight(1e-5)),
+  p2_sizing_risk = p2_sizing("p2_sizing_risk", "rebalance", ledgr::ledgr_cost_zero(), ledgr::ledgr_risk_max_weight(0.25)),
+  p2_hold_trim = p2_schedule("p2_hold_trim", stats::setNames(list(c(A = 40, B = 20, C = 100)), p2_days[2L]),
+    ledgr::ledgr_cost_zero(), ledgr::ledgr_risk_max_weight(0.3), cash = 5000)
+))
+loop_constructed <- c(loop_constructed, list(
+  p2_time_cost_risk = p2_crossover("p2_time_cost_risk", 10L, 7200L, p2_chain, ledgr::ledgr_risk_max_weight(0.05)),
+  p2_time_cost = p2_crossover("p2_time_cost", 10L, 7200L, p2_chain, ledgr::ledgr_risk_none())
+))
